#!/bin/bash
#
# Startup script for InsightFace API v2 (Async)
#
# This script starts the production server using Uvicorn with optimized settings
# for face detection workloads. Uses a single process with async I/O and a
# thread pool for CPU-bound inference operations.
#
# Architecture:
#   - Single process holds the ML model (~500MB)
#   - Async I/O handles many concurrent connections
#   - ThreadPoolExecutor (4 threads) manages inference queue
#   - ONNX runtime releases GIL during compute for true parallelism
#
# Environment Variables:
#   PORT                  - Server port (default: 5001)
#   TIMEOUT               - Keep-alive timeout in seconds (default: 60)
#   LOG_LEVEL             - Logging level (default: info)
#   MAX_IMAGE_DIMENSION   - Max image size for detection (default: 640)
#   DETECTION_THRESHOLD   - Face detection threshold (default: 0.5)
#   NEW_RELIC_LICENSE_KEY - New Relic license key (enables APM when set)
#   NEW_RELIC_APP_NAME    - New Relic application name (default: InsightFace API)
#

set -e

# Server configuration
PORT="${PORT:-5001}"
TIMEOUT="${TIMEOUT:-60}"
LOG_LEVEL="${LOG_LEVEL:-info}"

# Export API configuration for the application
export PORT
export LOG_LEVEL
export MAX_IMAGE_DIMENSION="${MAX_IMAGE_DIMENSION:-640}"
export DETECTION_THRESHOLD="${DETECTION_THRESHOLD:-0.5}"

echo "Starting InsightFace API v2 (Async)..."
echo "  Port: $PORT"
echo "  Timeout: ${TIMEOUT}s"
echo "  Log Level: $LOG_LEVEL"
echo "  Max Image Dimension: $MAX_IMAGE_DIMENSION"
echo "  Detection Threshold: $DETECTION_THRESHOLD"
echo "  Architecture: Single process + ThreadPoolExecutor (4 threads)"

# New Relic configuration
NEWRELIC_CMD=""
if [ -n "$NEW_RELIC_LICENSE_KEY" ]; then
    export NEW_RELIC_APP_NAME="${NEW_RELIC_APP_NAME:-InsightFace API}"
    NEWRELIC_CMD="newrelic-admin run-program"
    echo "  New Relic: enabled (${NEW_RELIC_APP_NAME})"
else
    echo "  New Relic: disabled"
fi
echo ""

# Start Uvicorn with the async application factory
exec $NEWRELIC_CMD uvicorn \
    --host="0.0.0.0" \
    --port="$PORT" \
    --timeout-keep-alive="$TIMEOUT" \
    --log-level="$LOG_LEVEL" \
    --factory \
    "src.app_async:get_app"
